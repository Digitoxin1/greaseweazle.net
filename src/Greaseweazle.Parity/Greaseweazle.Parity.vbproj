<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Greaseweazle.Parity</AssemblyName>
    <RootNamespace></RootNamespace>
    <OutputType>Exe</OutputType>
    <StartupObject>Greaseweazle.Parity.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Greaseweazle\Greaseweazle.vbproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
