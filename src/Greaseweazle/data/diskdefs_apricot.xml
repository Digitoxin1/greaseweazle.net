<?xml version='1.0' encoding='utf-8'?>
<diskdefs prefix="apricot.">
  <!--prefix: apricot.-->
  <disk name="single">
    <option key="cyls" value="70" />
    <option key="heads" value="1" />
    <tracks spec="*" format="ibm.mfm">
      <option key="secs" value="9" />
      <option key="bps" value="512" />
      <option key="gap3" value="84" />
      <option key="rate" value="250" />
      <option key="rpm" value="300" />
    </tracks>
  </disk>
  <disk name="double">
    <option key="cyls" value="80" />
    <option key="heads" value="2" />
    <tracks spec="*" format="ibm.mfm">
      <option key="secs" value="9" />
      <option key="bps" value="512" />
      <option key="gap3" value="84" />
      <option key="rate" value="250" />
      <option key="rpm" value="300" />
    </tracks>
  </disk>
</diskdefs>