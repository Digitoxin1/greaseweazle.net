<?xml version='1.0' encoding='utf-8'?>
<diskdefs prefix="rm.">
  <!--prefix: rm.-->
  <!--RM (Research Machines) 8-bit (RM 380Z/RML 480Z) disk definitions.-->
  <!--RM 8" -380Z DS/SD floppy disk format. 77 tracks, 2 heads, FM encoding.-->
  <disk name="8in.sd">
    <option key="cyls" value="77" />
    <option key="heads" value="2" />
    <tracks spec="0-76.0" format="ibm.fm">
      <option key="bps" value="128" />
      <option key="secs" value="26" />
      <option key="id" value="1" />
      <option key="h" value="0" />
    </tracks>
    <tracks spec="0-76.1" format="ibm.fm">
      <option key="bps" value="128" />
      <option key="secs" value="26" />
      <option key="id" value="1" />
      <option key="h" value="0" />
    </tracks>
  </disk>
  <!--RM 5.25" - 380Z DS/SD floppy disk format. 40 tracks, 2 heads, FM encoding.-->
  <disk name="5in.sd">
    <option key="cyls" value="40" />
    <option key="heads" value="2" />
    <tracks spec="0-39.0" format="ibm.fm">
      <option key="bps" value="128" />
      <option key="secs" value="16" />
      <option key="id" value="1" />
      <option key="h" value="0" />
    </tracks>
    <tracks spec="0-39.1" format="ibm.fm">
      <option key="bps" value="128" />
      <option key="secs" value="16" />
      <option key="id" value="1" />
      <option key="h" value="0" />
    </tracks>
  </disk>
  <!--RM 5.25" - 480Z DS/DD floppy disk format. 40 tracks, 2 heads, MFM encoding. Track 0 is SD (FM). Often called "DD"-->
  <disk name="5in.dd">
    <option key="cyls" value="40" />
    <option key="heads" value="2" />
    <tracks spec="0.0" format="ibm.fm">
      <option key="bps" value="128" />
      <option key="secs" value="16" />
      <option key="id" value="1" />
      <option key="h" value="0" />
    </tracks>
    <tracks spec="0.1" format="ibm.fm">
      <option key="bps" value="128" />
      <option key="secs" value="16" />
      <option key="id" value="1" />
      <option key="h" value="0" />
    </tracks>
    <tracks spec="1-39.0" format="ibm.mfm">
      <option key="bps" value="512" />
      <option key="secs" value="9" />
      <option key="id" value="1" />
      <option key="h" value="0" />
    </tracks>
    <tracks spec="1-39.1" format="ibm.mfm">
      <option key="bps" value="512" />
      <option key="secs" value="9" />
      <option key="id" value="1" />
      <option key="h" value="0" />
    </tracks>
  </disk>
  <!--RM 5.25" - 480Z DS/DD floppy disk format. 80 tracks, 2 heads, MFM encoding. Track 0 is SD (FM). Often called "QD"-->
  <disk name="5in.qd">
    <option key="cyls" value="80" />
    <option key="heads" value="2" />
    <tracks spec="0.0" format="ibm.fm">
      <option key="bps" value="128" />
      <option key="secs" value="16" />
      <option key="id" value="1" />
      <option key="h" value="0" />
    </tracks>
    <tracks spec="0.1" format="ibm.fm">
      <option key="bps" value="128" />
      <option key="secs" value="16" />
      <option key="id" value="1" />
      <option key="h" value="0" />
    </tracks>
    <tracks spec="1-79.0" format="ibm.mfm">
      <option key="bps" value="512" />
      <option key="secs" value="9" />
      <option key="id" value="1" />
      <option key="h" value="0" />
    </tracks>
    <tracks spec="1-79.1" format="ibm.mfm">
      <option key="bps" value="512" />
      <option key="secs" value="9" />
      <option key="id" value="1" />
      <option key="h" value="0" />
    </tracks>
  </disk>
</diskdefs>