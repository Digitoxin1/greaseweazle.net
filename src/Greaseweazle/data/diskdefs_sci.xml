<?xml version='1.0' encoding='utf-8'?>
<diskdefs prefix="sci.">
  <!--prefix: sci.-->
  <!--Sequential Circuits Prophet-->
  <disk name="prophet">
    <option key="cyls" value="80" />
    <option key="heads" value="2" />
    <tracks spec="*" format="ibm.mfm">
      <!--gap1 is reduced to give a bit more leeway at the end of the track-->
      <option key="gap1" value="20" />
      <option key="secs" value="6" />
      <option key="bps" value="1024*5,256" />
      <option key="id" value="0" />
      <option key="rate" value="250" />
    </tracks>
  </disk>
</diskdefs>